root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h,dts,dtsi,overlay}]
indent_style = tab
indent_size = 8

[Kconfig*]
indent_style = tab
indent_size = 8

[*.{yaml,yml,json}]
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf
