lr val="005968"/></a:solidFill><a:latin typeface="Consolas"/><a:ea typeface="Consolas"/><a:cs typeface="Consolas"/></a:defRPr></a:pPr><a:r><a:rPr sz="1875" b="0"><a:solidFill><a:srgbClr val="005968"/></a:solidFill><a:latin typeface="Consolas"/><a:ea typeface="Consolas"/><a:cs typeface="Consolas"/></a:rPr><a:t>python -c 'import sys; print(sys.executable); print(sys.platform)'</a:t></a:r></a:p><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr><a:defRPr sz="1875" b="0"><a:solidFill><a:srgbClr val="005968"/></a:solidFill><a:latin typeface="Consolas"/><a:ea typeface="Consolas"/><a:cs typeface="Consolas"/></a:defRPr></a:pPr><a:r><a:rPr sz="1875" b="0"><a:solidFill><a:srgbClr val="005968"/></a:solidFill><a:latin typeface="Consolas"/><a:ea typeface="Consolas"/><a:cs typeface="Consolas"/></a:rPr><a:t>python -m pip install west</a:t></a:r></a:p><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr><a:defRPr sz="1875" b="0"><a:solidFill><a:srgbClr val="005968"/></a:solidFill><a:latin typeface="Consolas"/><a:ea typeface="Consolas"/><a:cs typeface="Consolas"/></a:defRPr></a:pPr><a:r><a:rPr sz="1875" b="0"><a:solidFill><a:srgbClr val="005968"/></a:solidFill><a:latin typeface="Consolas"/><a:ea typeface="Consolas"/><a:cs typeface="Consolas"/></a:rPr><a:t>west --version</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="4" name="explanation"><a:extLst xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{236C5284-4675-4580-B9E9-6ECC901E61EF}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noGrp="1"/></p:cNvSpPr><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:off x="609600" y="4762500"/><a:ext cx="10972800" cy="1257300"/></a:xfrm><a:prstGeom xmlns:a="http: