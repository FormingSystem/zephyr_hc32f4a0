# Preserve the inherited validator, then enforce the project detail policy.

msg_file="$1"
sh "$(dirname "$0")/upstream/commit-msg" "$msg_file" || exit $?

body_lines="$(tail -n +2 "$msg_file" | grep -Ev '^[[:space:]]*(#.*)?$' || true)"
if ! printf '%s\n' "$body_lines" | grep -Eq '^- [^[:space:]]'; then
  printf '%s\n' '本项目每条提交必须包含至少一行“- 具体明细”，不能只写标题。' >&2
  exit 1
fi
if printf '%s\n' "$body_lines" | grep -Eq '^- [[:space:]]*$'; then
  printf '%s\n' '提交明细不能为空或只有空白。' >&2
  exit 1
fi
exit 0
